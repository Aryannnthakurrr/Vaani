# Automatic HTTPS (Let's Encrypt) for the Droplet's sslip.io name. WebSockets (/live/*) pass through unchanged.
{
	# Let's Encrypt's default ECDSA chain (YE1 -> Root YE) is not trusted by older Android, Windows schannel or older
	# certifi bundles. An RSA key with the chain anchored at "ISRG Root X1" works everywhere.
	key_type rsa2048
	preferred_chains {
		root_common_name "ISRG Root X1"
	}
}

165-245-196-218.sslip.io {
	encode gzip
	reverse_proxy backend:8000 {
		# Gemini Live voice and camera sessions can stay open for minutes.
		transport http {
			read_timeout 0
			write_timeout 0
		}
	}
	log {
		output stdout
		format console
	}
}
