GEMINI_API_KEY=            # empty → mock mode
SARVAM_API_KEY=            # empty → app falls back to Android on-device speech
MOCK=1                     # force mock even when a key exists
SAFE_BROWSING_API_KEY=     # optional; skip that check if empty
TELEGRAM_BOT_TOKEN=        # from @BotFather; empty → alerts are logged only
WELFARE_CHECK_TIME=12:00   # local time, Asia/Kolkata
WELFARE_PROMPT_TIME=11:30  # on-device "are you okay?" prompt
TIMEZONE=Asia/Kolkata
DATABASE_URL=sqlite:///./saathi.db
SANDBOX_ENABLED=0          # 1 only inside the Docker image; never visit untrusted URLs on a laptop
DASHBOARD_SECRET=          # random string; signs family dashboard links (empty → links change on restart)
PUBLIC_BASE_URL=           # e.g. https://saathi.example.com; when set, family alerts include the dashboard link
BOLNA_API_KEY=             # real clinic calls via Bolna (used instead of Twilio when both Bolna values are set)
BOLNA_AGENT_ID=            # printed by scripts/bolna_agent.py
TWILIO_ACCOUNT_SID=        # real clinic calls (stretch): Twilio account SID
TWILIO_AUTH_TOKEN=         # also used to verify Twilio webhook signatures
TWILIO_FROM_NUMBER=        # your Twilio number, E.164, e.g. +15551234567
CALL_ALLOWED_NUMBERS=      # comma-separated numbers Saathi may call (the clinic, or your own phone for testing)
MEKO_API_KEY=              # Meko (Yugabyte) agent memory: mko_tkn_… from cloud.mekodata.ai → Settings → API Keys; empty → local SQLite memory

SKILL_MIN_RUNS=3           # successful LLM runs of a task before the strong model compiles a routine for it
SKILL_SHADOW_AGREE=3       # agreeing shadow runs before a routine serves steps on its own
SKILL_AUTO_APPROVE=0       # 1 = skip family approval (demos only)
SKILL_SANDBOX=subprocess   # docker on the server: compiled Python skills run in the saathi-skill-sandbox image
SKILL_MIN_SAMPLES=40       # /intent answers collected before the strong model writes a Python recogniser for them
