GEMINI_API_KEY=            # empty → mock mode
SARVAM_API_KEY=            # empty → app falls back to Android on-device speech
MOCK=1                     # force mock even when a key exists
SAFE_BROWSING_API_KEY=     # optional; skip that check if empty
TELEGRAM_BOT_TOKEN=        # from @BotFather; empty → alerts are logged only
WELFARE_CHECK_TIME=12:00   # local time, Asia/Kolkata
WELFARE_PROMPT_TIME=11:30  # on-device "are you okay?" prompt
TIMEZONE=Asia/Kolkata
DATABASE_URL=sqlite:///./saathi.db
SANDBOX_ENABLED=0          # 1 only inside the Docker image; never visit untrusted URLs on a laptop
DASHBOARD_SECRET=          # random string; signs family dashboard links (empty → links change on restart)
PUBLIC_BASE_URL=           # e.g. https://saathi.example.com; when set, family alerts include the dashboard link
BOLNA_API_KEY=             # every real call (clinic confirmation and hospital calls) goes through Bolna
BOLNA_AGENT_ID=            # printed by scripts/bolna_agent.py
CALL_ALLOWED_NUMBERS=      # comma-separated numbers Saathi may ever dial; the first is the test phone for masked calls
MEKO_API_KEY=              # Meko (Yugabyte) agent memory: mko_tkn_… from cloud.mekodata.ai → Settings → API Keys; empty → local SQLite memory

SKILL_MIN_RUNS=3           # successful LLM runs of a task before the strong model compiles a routine for it
SKILL_SHADOW_AGREE=3       # agreeing shadow runs before a routine serves steps on its own
SKILL_AUTO_APPROVE=0       # 1 = skip family approval (demos only)
SKILL_SANDBOX=subprocess   # docker on the server: compiled Python skills run in the saathi-skill-sandbox image
SKILL_MIN_SAMPLES=40       # /intent answers collected before the strong model writes a Python recogniser for them

# Symptom-to-care (docs/CARE.md)
GOOGLE_MAPS_API_KEY=       # Places API (New) + Routes API; empty → no hospital search (DEMO_MODE uses demo hospitals)
BOLNA_INQUIRY_AGENT_ID=    # scripts/bolna_agent.py --mode inquiry: asks hospitals about doctor availability
BOLNA_BOOKING_AGENT_ID=    # scripts/bolna_agent.py --mode booking: books the chosen slot
BOLNA_TOOL_SECRET=         # shared with the inquiry agent's check_with_patient tool (mid-call yes); needs an https PUBLIC_BASE_URL
CALL_MAX_SEC=150           # talk limit per hospital call
DEMO_MODE=0                # 1 = stand-in hospitals when GOOGLE_MAPS_API_KEY is empty
MASK_HOSPITAL_NUMBERS=1    # 1 (default) = every hospital call rings the test number, not the hospital
DEMO_PHONE_MAP=            # JSON {"<place_id>": "+91…"} or a comma list used round-robin; numbers must be in CALL_ALLOWED_NUMBERS
MOCK_AMBULANCE_BASE_URL=http://localhost:9000   # the mock dispatch API (bash scripts/mock_ambulance.sh); never a real service
MOCK_AMBULANCE_API_KEY=dev-key
EMERGENCY_COUNTDOWN_SEC=15 # siren countdown before the automatic (mock) dispatch
SIM_SPEED_MULTIPLIER=10    # mock ambulance speed-up for demos (10 → a 7-minute drive takes ~40 s)
